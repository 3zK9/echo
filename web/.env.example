NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret
AUTH_SECRET=replace-with-the-same-random-secret
AUTH_GITHUB_ID=replace-with-your-github-oauth-client-id
AUTH_GITHUB_SECRET=replace-with-your-github-oauth-client-secret
AUTH_TRUST_HOST=true
DATABASE_URL=postgresql://user:password@pooled-host:6543/database?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://user:password@direct-host:5432/database

# Owner-only dashboard. Use immutable numeric GitHub account IDs, not usernames.
ADMIN_GITHUB_ACCOUNT_IDS=12345678
# Must authenticate as the SELECT-only role described in docs/admin-metrics.md.
METRICS_DATABASE_URL=postgresql://echo_metrics_app:password@pooled-host:6543/database?pgbouncer=true&connection_limit=1
